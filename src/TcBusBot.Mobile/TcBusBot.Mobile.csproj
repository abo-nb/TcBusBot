<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Android 版：**與桌面版共用同一份 Bot 原始碼**（不是另一個實作）。

    ⚠️ 為什麼不是「ProjectReference TcBusBot.Discord」：
       Android App 必須是 self-contained（Mono 執行階段要打包進去），
       而 .NET SDK 不允許 self-contained 專案參考「非 self-contained 的 Exe」專案
       （NETSDK1150）。把 App 改成 <SelfContained>false</SelfContained> 可以繞過那個檢查，
       但**會讓 Android 的執行階段完全起不來**。實機 A/B 測試（同一支 hello-world）：

         * 預設設定            → 正常啟動
         * SelfContained=false → java.lang.UnsatisfiedLinkError:
                                 No implementation found for …MainActivity.n_onCreate

       所以那條路確定走不通（見 docs §17.1 的說明）。

       改成用 <Compile Include> 把 TcBusBot.Discord 的 .cs 全部編進來：
         * TcBusBot.Discord 專案**完全不動**（維持 Exe、維持 dotnet run 可用）
         * 磁碟上仍然只有一份實作 —— 沒有複製、不會分岔
         * 以後在 TcBusBot.Discord 新增檔案，這裡自動包含（glob，不用維護清單）

    ⚠️ GenerateProgramFile=false：
       有了 TcBusBot.Discord 的 Program.Main 當進入點，就不能再讓 SDK 自動產生一個空的
       Main（否則兩個進入點）。Android 的實際啟動是走 JNI，
       Main 只是「我們自己用程式呼叫的 Bot 進入點」。

    ⚠️ AndroidLinkMode=None / PublishTrimmed=false / RunAOTCompilation=false：
       Discord.Net 大量使用反射，裁剪後會在手機上「執行期才炸」。
       代價是 APK 較大（約 44 MB），對自己部署完全可接受。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>TcBusBot.Mobile</RootNamespace>
    <AssemblyName>TcBusBot.Mobile</AssemblyName>
    <GenerateProgramFile>false</GenerateProgramFile>

    <ApplicationId>com.tcbusbot.mobile</ApplicationId>
    <ApplicationTitle>台中公車通知</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>

    <AndroidLinkMode>None</AndroidLinkMode>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <EnableLLVM>false</EnableLLVM>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>

    <!-- 舊手機可能是 32 位元（armeabi-v7a），兩個都包才不會裝不起來 -->
    <RuntimeIdentifiers>android-arm64;android-arm</RuntimeIdentifiers>

    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- ★ 與桌面版共用的 Bot 原始碼（單一真相來源） -->
    <Compile Include="..\TcBusBot.Discord\**\*.cs"
             Exclude="..\TcBusBot.Discord\bin\**;..\TcBusBot.Discord\obj\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 與 TcBusBot.Discord 相同的套件（Bot 本體需要的） -->
    <PackageReference Include="Discord.Net" Version="3.18.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TcBusBot.Core\TcBusBot.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 沒有 TDX 金鑰時的離線資料集（與桌面版能力一致） -->
    <AndroidAsset Include="..\..\tests\fixtures\mini\Stops.psv" Link="mini\Stops.psv" />
    <AndroidAsset Include="..\..\tests\fixtures\mini\StopOfRoute.psv" Link="mini\StopOfRoute.psv" />
  </ItemGroup>

</Project>
