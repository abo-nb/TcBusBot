<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>TcBusBot.Discord</RootNamespace>
    <AssemblyName>tcbus-bot</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <!-- Discord.Net 3.18.0：本機 NuGet 快取已有，離線也能建置。
         服務的組裝在 BotServices.cs（用 Microsoft.Extensions.DependencyInjection，
         由 TcBusBot.Core 帶進來；以前是自己手寫的 SimpleServiceProvider）。
         刻意不用 Microsoft.Extensions.Hosting —— 這個專案只有一個進入點，
         不需要它的生命週期與設定系統。 -->
    <PackageReference Include="Discord.Net" Version="3.18.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TcBusBot.Core\TcBusBot.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\.dockerignore">
      <Link>.dockerignore</Link>
    </Content>
  </ItemGroup>

</Project>
