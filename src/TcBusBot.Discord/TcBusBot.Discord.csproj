<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>TcBusBot.Discord</RootNamespace>
    <AssemblyName>tcbus-bot</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Discord.Net 3.18.0：本機 NuGet 快取已有，離線也能建置。
         刻意不使用 Microsoft.Extensions.Hosting（快取裡沒有），
         改在 Program.cs 手工組裝 —— 這個專案本來就不需要 DI 容器。 -->
    <PackageReference Include="Discord.Net" Version="3.18.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TcBusBot.Core\TcBusBot.Core.csproj" />
  </ItemGroup>

</Project>
