# ─────────────────────────────────────────────────────────
#  複製這個檔案改名為 .env，填入你的值。
#  .env 已經在 .gitignore 裡，不會被提交。
#
#  也支援 PowerShell 風格：$env:DISCORD_TOKEN=xxx
# ─────────────────────────────────────────────────────────

# Discord Bot Token（必填）
# 取得方式：https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=

# TDX API 金鑰（選填）
# 沒有金鑰時會使用內建最小資料集（只有臺中車站～靜宜大學走廊），
# 仍然可以完整驗收 Discord 互動流程與通知長相。
# 取得方式：https://tdx.transportdata.tw/register → 會員中心 → 資料服務 → API 金鑰
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# ── 以下是選填的進階設定 ──────────────────────────────

# 只把指令註冊到某個伺服器（否則自動註冊到 Bot 已加入的全部伺服器）
# DISCORD_GUILD_ID=

# 資料來源：auto（預設，有 TDX 金鑰就用 TDX）| fixture | tdx
# TCBUS_DATA=auto

# 即時輪詢間隔（秒）。台中 N1 來源端約 20 秒才更新，低於 20 沒有意義。
# TCBUS_POLL_INTERVAL=30

# 預設的提前通知分鐘數
# TCBUS_NOTIFY_MINUTES=10

# 靜態資料快取目錄
# TCBUS_CACHE=cache

# 訂閱組的 SQLite 資料庫路徑（`:memory:` 表示不落地）
# 這是唯一使用資料庫的地方 —— 訂閱本身仍在記憶體，重啟會消失；
# 只有使用者刻意存下來的「訂閱組」需要持久化。
# TCBUS_DB=tcbus.db

# 允許使用 /say（讓 Bot 幫你說話）的 Discord 使用者 ID，逗號分隔。
# 不設定 = 所有人都能用。自己的 Bot 預設從寬；在多人伺服器建議設定。
# SAY_ALLOWED_USERS=123456789012345678,987654321098765432
