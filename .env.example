# ─────────────────────────────────────────────────────────
#  複製這個檔案改名為 .env，填入你的值。
#  .env 已經在 .gitignore 裡，不會被提交。
#
#  也支援 PowerShell 風格：$env:DISCORD_TOKEN=xxx
# ─────────────────────────────────────────────────────────

# Discord Bot Token（必填）
# 取得方式：https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=

# TDX API 金鑰（選填）
# 沒有金鑰時會使用內建最小資料集（只有臺中車站～靜宜大學走廊），
# 仍然可以完整驗收 Discord 互動流程與通知長相。
# 取得方式：https://tdx.transportdata.tw/register → 會員中心 → 資料服務 → API 金鑰
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# ── 以下是選填的進階設定 ──────────────────────────────

# 只把指令註冊到某個伺服器（否則自動註冊到 Bot 已加入的全部伺服器）
# DISCORD_GUILD_ID=

# 資料來源：auto（預設，有 TDX 金鑰就用 TDX）| fixture | tdx
# TCBUS_DATA=auto

# 即時輪詢間隔（秒）。台中 N1 來源端約 20 秒才更新，低於 20 沒有意義。
# TCBUS_POLL_INTERVAL=30

# 預設的提前通知分鐘數
# TCBUS_NOTIFY_MINUTES=10

# 靜態資料快取目錄
# TCBUS_CACHE=cache

# 訂閱組的 SQLite 資料庫路徑（`:memory:` 表示不落地）
# 這是唯一使用資料庫的地方 —— 訂閱本身仍在記憶體，重啟會消失；
# 只有使用者刻意存下來的「訂閱組」需要持久化。
# TCBUS_DB=tcbus.db

# 允許使用 /say（讓 Bot 幫你說話）的 Discord 使用者 ID，逗號分隔。
# 不設定 = 所有人都能用。自己的 Bot 預設從寬；在多人伺服器建議設定。
# SAY_ALLOWED_USERS=123456789012345678,987654321098765432

# ── AI 聊天（選填；OpenAI 相容 API，Semantic Kernel 實作）──────
# 有填 LLM_API_KEY 才會啟用。任何 OpenAI 相容服務都可以：
#   DeepSeek  https://api.deepseek.com/v1
#   OpenAI    https://api.openai.com/v1
#   OpenRouter https://openrouter.ai/api/v1
#   自架 Ollama http://127.0.0.1:11434/v1
# ⚠️ 啟用之後 Bot 會要求 Message Content 特權意圖，必須同時在
#    Discord Developer Portal → Bot → Privileged Gateway Intents
#    打開 Message Content Intent（否則 4014 拒絕連線）。
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-flash

# 「這句話是在跟我說話嗎」「換話題了沒」這類**極短判斷**用的模型（留空＝跟主模型一樣）。
# 這兩種判斷只要回一個單字，但次數多（偷聽中每一則沒被 @ 的訊息都要問一次），
# 用便宜的小模型就夠了；聊天與工具呼叫仍然走主模型。
# 例：LLM_MODEL=deepseek-v4-pro（聰明的那個）＋ LLM_JUDGE_MODEL=deepseek-flash（快又便宜）
# ⚠️ 打錯模型名稱不會在啟動時報錯，只會在判斷的那一瞬間失敗
#    （偷聽會變成「先不出聲」，不會亂回話）；啟動 log 與 --dryrun 都會把兩個名稱印出來。
# LLM_JUDGE_MODEL=
# 每週 token 上限（**全域**，UTC 週一 00:00 重置；0 = 不限）
# LLM_WEEKLY_TOKENS=300000

# 超過這個分鐘數沒說話就當成新的段落（不帶舊上下文；時間內則由 LLM 判斷換話題了沒）
# LLM_SEGMENT_GAP_MINUTES=30

# 帶進提示詞的歷史上限（則數／估算 token 數）
# LLM_MAX_CONTEXT_TURNS=20
# LLM_MAX_CONTEXT_TOKENS=3000

# 單次回覆的輸出上限與溫度
# LLM_MAX_OUTPUT_TOKENS=800
# LLM_TEMPERATURE=0.7

# 同一個人連續問的冷卻秒數（避免連點燒額度）
# LLM_USER_COOLDOWN_SECONDS=3

# 私訊也可以聊（預設 false：私訊沒有「@ 機器人」的動作，容易被誤觸）
# LLM_ALLOW_DM=false

# 要不要讓 LLM 判斷「換話題了」（預設 true；關掉就只靠時間切段）
# LLM_TOPIC_DETECT=true

# 要不要讓 LLM 用工具**真的動手**（訂閱公車、取消訂閱…）
# 關掉就只剩聊天 —— 模型不會有任何改變資料的能力
# LLM_TOOLS=true

# 模型要不要「思考」（reasoning／thinking）。
# 這個用途不需要思考，而思考會吃掉輸出額度又算錢
# （實測同一個問題：auto＝out 660 tokens、off＝out 20 tokens）。
#   off（預設）：送 reasoning_effort=none ＋ thinking={type:disabled}（實測兩種寫法都有效）
#   auto      ：完全不動，用服務端預設（換到不認識這些欄位的服務時設這個）
#   low / medium / high：明確要思考（只送 reasoning_effort）
# LLM_REASONING=off

# ── 認人與「主人」授權 ──────────────────────────────────────

# 要不要讓模型看到傳訊息的人是誰（伺服器暱稱 ＋ @帳號 ＋ Discord ID）。
# 給了 ID 它才分得出同名的人，也才能把規則綁在特定人身上；代價是它可能把 ID 貼出來。
# LLM_EXPOSE_IDS=true

# 要不要讓模型在回覆裡 @ 別人（只開放 @ 使用者；@everyone／身分組一律擋掉）。
# LLM_ALLOW_MENTIONS=true
# 讓模型看到 **Discord 暱稱**（伺服器的顯示名稱）而不是 @帳號。
# 為什麼預設要開：頻道上大家互相稱呼的是暱稱（「小明」），不是帳號（@wuxiaohan0922）。
# 模型要聽得懂「小明剛剛說的」「叫小明來」就必須看到暱稱 ——
# 判斷「這句是不是在對我說話」與判斷話題時尤其重要（那兩段提示詞原本只寫帳號）。
# 也會讓它知道**自己在這個伺服器被叫什麼**（伺服器把 Bot 改暱稱時，
# 有人喊那個名字它才知道是在叫它）。
# 關掉（false）＝一律用帳號：同一個人在不同伺服器有一致的身分，認人改成靠帳號。
# 不管開或關，主對話的標籤都還是「暱稱(@帳號, ID)」，所以同名的人分得出來。
# LLM_SHOW_NICKNAMES=true

# 後台指定的「主人」Discord 使用者 ID（逗號分隔）。
# ⚠️ 要下命令還必須在訊息裡帶上 LLM_ADMIN_KEY，兩個條件都成立才算授權。
# LLM_ADMIN_IDS=123456789012345678

# 授權用的特殊 key（**沒設定就等於整個主人機制關閉**）。
# 主人的訊息要長這樣：   OWNER-KEY-xxxx 記住：以後都要叫我主人
# ⚠️ 打在有別人看得到的地方等於公開這把鑰匙 —— 請在私訊或私人頻道使用。
# LLM_ADMIN_KEY=
# 讓模型幫使用者「按面板的按鈕」（開面板／設起訖／找路線／訂閱／復原上一動作）。
# 動作改的是同一份面板狀態，回覆也會附上真正的元件，使用者想接手自己點也可以。
# LLM_UI_ACTIONS=true

# 偷聽模式：回完話之後繼續聽「沒有 @ 它」的訊息。
# 由 LLM 判斷三種結果：接話（REPLY）／先不出聲但留下來（SKIP）／退出回到等 @（STOP）。
# ⚠️ 需要 Message Content 特權意圖（沒開的話非提及訊息的內容是空的）。
# ⚠️ 每一則要判斷的訊息都會多花一次判斷的錢，所以有「判斷則數」與「閒置秒數」兩個上限。
# LLM_EAVESDROP=true
# LLM_EAVESDROP_MESSAGES=20
# LLM_EAVESDROP_SECONDS=120
# 偷聽到的閒聊要不要留下來當上下文（之後 @ 它時才接得上大家在聊什麼）。
# 這些訊息在提示詞裡標成 [閒聊]，模型知道那是背景、不會去回它們。
# LLM_EAVESDROP_CONTEXT=true

# ── 多人同時說話（排隊，不是「忙就丟掉」）──────────────────────
# 每個頻道最多排幾則等回覆（超過才丟，而且先丟閒聊、不丟 @ 它的）。
# 以前是「同一頻道一次只處理一則，忙的時候直接丟掉」—— 第二個 @ 它的人會被默默吃掉。
# LLM_CHANNEL_QUEUE=5
# 同一個人在幾秒內連打的訊息會合併成一題（「在嗎」「300 幾點」→ 一題）；0 = 不合併。
# LLM_MERGE_SECONDS=4

# ── 圖片理解（讓模型看得懂圖片與貼圖）────────────────────────
# ⚠️ 只有「使用者指定」才會用：只有被 @ 或回覆的訊息才可能附圖，
#    偷聽到的訊息、別人聊天裡的照片一律不送（成本 ＋ 隱私）。
#    回覆某張圖的訊息時，被回覆那一則的圖片也算（「這張圖是什麼？」很自然）。
# 成本：每一張圖最多約 1024 tokens（官方換算：縮到約 1300×1300 的總像素）。
# 支援的格式：JPEG、PNG、GIF、WebP；Discord 貼圖只有 PNG／APNG（Lottie 動畫不行）。
# LLM_VISION=true
# 一次最多附幾張（0 = 關閉）
# LLM_VISION_MAX_IMAGES=2

# ── 對話記憶的容量（全部都是記憶體；Discord 重啟就沒了）──────────
# 一個段落最多留幾則（超過丟最舊的）。這是「記得多少」，
# 跟「每次送幾則給模型」的 LLM_MAX_CONTEXT_TURNS 是兩件事，前者建議 ≥ 後者。
# LLM_MAX_TURNS_PER_SEGMENT=24
# 每個頻道最多留幾段（留著是為了「回覆很舊的訊息」還接得上）。
# LLM_MAX_SEGMENTS_PER_CHANNEL=4
# 同時追蹤幾個頻道（超過淘汰最久沒動的）。這是整台 Bot 的記憶體上限。
# LLM_MAX_CHANNELS=500
# 頻道多久沒動就整個忘掉（小時，可給小數）。
# LLM_CHANNEL_TTL_HOURS=12

# ── 「學到的提示詞」（每個伺服器一份的 overlay）要存多少 ──────────
# 這幾個同時決定「提示詞會多長」（＝每次對話的錢）與
# 「任何人都能叫 Bot 記多少東西」（公開伺服器的濫用風險）。
# 私人小伺服器可以放寬，公開大伺服器建議收緊。
# 每個伺服器最多幾條（全域規則共用這個上限）。
# LLM_MAX_GUILD_RULES=40
# 每一條最多幾個字。
# LLM_MAX_RULE_CHARS=300
# 最多幾個伺服器有自己的規則（超過淘汰條數最少的）。
# LLM_MAX_PERSONA_GUILDS=200
# 這些規則接進提示詞的總長上限。
# LLM_MAX_OVERLAY_CHARS=2000
# 主人操作紀錄最多留幾筆。
# LLM_MAX_AUDIT_ENTRIES=200
# ── 要載入哪些城市的公車資料（預設臺中；可以多個）────────────
# 接受英文代碼（Taichung／Tainan／Kaohsiung…）或中文（臺中／台中／臺南／台南）。
# 列出的城市 = **使用者可以選的選項**（用 `/bus city` 自己選；沒選過的人用第一個）。用逗號（或頓號、空白）分隔，例如
#     BUS_CITY=Taichung,Tainan      ← 臺中 ＋ 臺南一起用
#   每個城市各載入一份資料（站牌 UID 有城市前綴 TXG…／TNN…，各自獨立），
#   即時到站會按城市分批查（ETA 網址裡有城市）。
# 每個城市的**快取檔名都不一樣**（Stop.Taichung.json／Stop.Tainan.json），
# 所以換城市不會讀到上一個城市的資料。
# ⚠️ 內建最小資料集只有臺中的走廊：不是「只有臺中」時必須有 TDX 金鑰（或先抓好快取）。
# BUS_CITY=Taichung
# BUS_CITY=Taichung,Tainan