tcbus.db
tcbus.db-wal
tcbus.db-shm
*.db
*.db-wal
*.db-shm

# ── .NET 建置產物 ──────────────────────────────────────
bin/
obj/
*.user
*.suo

# ── 編輯器 ─────────────────────────────────────────────
.vs/
.vscode/
.idea/

